{
    "name": "waimart/ecommerce",
    "description": "Waimart single-store e-commerce (PHP + MariaDB)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Waimart\\": "app/" },
        "files": ["app/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Waimart\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.2.12" }
    }
}
