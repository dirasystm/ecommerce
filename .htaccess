# Basemall: site root. Only public/ is served; everything else is denied.
# IMPORTANT on cPanel: this file starts with a dot, so File Manager hides it unless "Show Hidden Files" is ticked.
# If it is missing, visitors see the setup page in index.php instead of the shop.
# Every private folder also has its own "Require all denied" .htaccess, so it stays protected even without this file.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Block direct access to source, config, data and tooling.
RewriteRule ^(\.git|\.env|app|bin|config|database|docs|routes|storage|tests|vendor)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|bootstrap\.php|phpunit\.xml.*|.*\.md|LICENSE)$ - [F,L]

# Route everything else (including the home page) into public/.
RewriteRule ^$ public/ [L]
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [L]
